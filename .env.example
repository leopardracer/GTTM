# --- Robinhood Chain ---
CHAIN_ID=4663
# Fill in from https://docs.robinhood.com/chain/ — no default is baked in
# because public endpoints vary in what they allow (see README).
RPC_URL=

# --- $GTTM ---
# Leave empty to run in DEMO MODE with clearly labeled mock data.
GTTM_CONTRACT_ADDRESS=
GTTM_DECIMALS=18

# Pool address once the token has a live pool (post-graduation on pons v2,
# or any Uniswap-v2-style pair). Leave empty pre-launch.
POOL_ADDRESS=

# Public wallet that spends creator fees buying $GTTM back (roadmap Phase 3).
# Leave empty if not applicable / not yet known.
BUYBACK_WALLET=

# --- Milestones (project lore, not live data) ---
# Used by `gttm mission` / `gttm moon` to show progress toward a target.
# This is a target you define, not a fetched number.
NEXT_MILESTONE_USD=1000000

# --- Optional: USD conversion for the pair asset (usually ETH) ---
# Uses CoinGecko's public simple-price endpoint, no API key needed. If this
# is unset or the request fails, USD figures show DATA UNAVAILABLE instead
# of a guess, and everything still works in the pair asset's own units.
PAIR_ASSET_COINGECKO_ID=ethereum

# --- Watch / signal windows ---
WATCH_POLL_MS=5000
SIGNAL_WINDOW_BLOCKS=50000
