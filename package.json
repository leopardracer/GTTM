{
  "name": "gttm",
  "version": "0.3.0",
  "description": "the open-source mission terminal for Grok To The Moon ($GTTM). six agents. one human. one mission. read-only, no keys, no trading.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gttm": "./bin/gttm.js"
  },
  "scripts": {
